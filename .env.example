# Rinomina questo file in .env e compila le credenziali.
# Lo script test_irsap_api.py carica automaticamente .env se presente nella root del progetto.

# Credenziali obbligatorie Cognito (le stesse usate nell'app IRSAP)
IRSAP_USERNAME=il_tuo_username
IRSAP_PASSWORD=la_tua_password

# envID opzionale: se non impostato lo script farà una query ListEnvironments per ricavarlo.
# IRSAP_ENV_ID=xxxxxxxxxxxxxxxx
